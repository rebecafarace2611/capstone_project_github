# Proprietary company data: never commit raw, processed, split, or metadata files
data/*
!data/README.md

# Row-level and reconstructable derived data
outputs/**/*.parquet
outputs/**/*prediction*.csv
outputs/**/fold_assignments.*

# Final report documents remain local
reports/**/*.docx

# Trained model artifacts may retain proprietary information
*.rds
*.joblib
*.pkl
*.pickle
*.model
*.bin

# Local configuration and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Python and Jupyter generated files
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# Project-local R package library
.r-library/
.RData
.Rhistory
Rplots.pdf

# Local logs and temporary files
runs/
logs/
*.log
*.tmp
~$*

# Prototype runtime artifacts
prototype_phase12/artifacts/models/
prototype_phase12/artifacts/*.parquet
prototype_phase12/artifacts/claim_pool_*.json
prototype_phase12/artifacts/claim_pool_*.csv
prototype_phase12/artifacts/category_map.json
prototype_phase12/artifacts/*.model
prototype_phase12/artifacts/*model*.txt
prototype_phase12/artifacts/xgboost*.json
